FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates libssl3 libfontconfig1 libstdc++6 && rm -rf /var/lib/apt/lists/*
WORKDIR /
COPY storyteller-web /storyteller-web
COPY includes/ /includes/
COPY storyteller-web.*.env /
RUN touch .env .env-secrets && ldd /storyteller-web | tee /tmp/ldd && ! grep -q 'not found' /tmp/ldd
EXPOSE 12345
CMD ["/storyteller-web"]
