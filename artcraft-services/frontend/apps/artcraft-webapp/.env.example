# Google OAuth Configuration
# Get the Client ID from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Optional production build override for a self-hosted ArtCraft API.
# Use an HTTPS origin without a path or trailing slash.
# VITE_ARTCRAFT_API_ORIGIN=https://api.example.com
